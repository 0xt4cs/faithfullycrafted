{
  "name": "faithfullycrafted",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "fetch-gallery": "node scripts/fetch-gallery.mjs",
    "prune-gallery": "node scripts/prune-gallery.mjs",
    "build": "node scripts/fetch-gallery.mjs && astro build",
    "build:only": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "npm run check && npm run lint && npm run format:check && npm run build:only && npm test && npm run test:e2e",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.1",
    "@astrojs/sitemap": "^3.7.1",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.13.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.20.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^15.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
