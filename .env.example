# Facebook Graph API (build-time only — never exposed to browser)
FB_PAGE_ID=FACEBOOK_PAGE_ID
FB_ACCESS_TOKEN=FACEBOOK_ACCESS_TOKEN

# Cloudflare Turnstile — order form bot check (see docs/order-endpoint.md)
#
# Site key. Public by design: it ships in the HTML of /order so the widget can
# render. The PUBLIC_ prefix is what makes Astro expose it to client code. It is
# needed at BUILD time, so it also has to exist wherever the site is built
# (GitHub Actions, Cloudflare Pages build, local `npm run dev`).
PUBLIC_TURNSTILE_SITE_KEY=TURNSTILE_SITE_KEY

# Secret key. Server-side only: read by functions/api/order.ts to call
# siteverify. Never commit the real value and never send it to the browser. In
# production it is a Pages secret, not a build variable:
#   npx wrangler pages secret put TURNSTILE_SECRET_KEY --project-name=faithfullycrafted
# For local `wrangler pages dev`, put the real value in .env (git-ignored) or
# pass it with `--binding TURNSTILE_SECRET_KEY=...`.
TURNSTILE_SECRET_KEY=TURNSTILE_SECRET_KEY

# Optional order-email overrides. Both have sensible defaults baked into
# functions/api/order.ts, so leave them unset unless something needs to change.
# ORDER_TO_EMAIL   — where order requests are delivered. Default:
#                    faith@faithfullycrafted.ph
# ORDER_FROM_EMAIL — the From address. Must sit on a domain onboarded to
#                    Cloudflare Email Sending. Default: orders@faithfullycrafted.ph
# ORDER_TO_EMAIL=faith@faithfullycrafted.ph
# ORDER_FROM_EMAIL=orders@faithfullycrafted.ph
