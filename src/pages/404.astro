---
import Layout from '@layouts/Layout.astro';
import Button from '@components/ui/Button.astro';
---

<Layout
  title="Page not found"
  description="That page does not exist. Head back to the gallery or the home page."
  noindex
>
  <section
    class="relative flex min-h-[70dvh] items-center justify-center overflow-hidden"
    aria-label="Page not found"
  >
    <!--
      Ghost numeral. Drawn as SVG text so it scales with its own viewBox
      instead of needing an inline font-size clamp, and so it can colour
      itself with a decorative `fill-*` token rather than a text colour.
    -->
    <svg
      class="pointer-events-none absolute inset-x-0 top-1/2 mx-auto w-[min(88%,40rem)] -translate-y-1/2 fill-rose-tint/40 select-none"
      viewBox="0 0 320 150"
      aria-hidden="true"
    >
      <text x="160" y="118" text-anchor="middle" font-size="150" class="font-brand">404</text>
    </svg>

    <div class="relative mx-auto max-w-lg px-4 text-center" data-reveal="up">
      <!-- Yarn ball with an unravelling trail: the one animated moment here -->
      <div class="relative mx-auto mb-8 h-28 w-28">
        <svg
          class="h-28 w-28 animate-spin-slow"
          viewBox="0 0 120 120"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="60" cy="60" r="44" class="fill-rose-brand/15"></circle>
          <circle cx="60" cy="60" r="32" class="fill-rose-brand/10"></circle>
          <circle cx="60" cy="60" r="20" class="fill-rose-brand/20"></circle>
          <path
            d="M28 72c12-24 24-30 30-54M38 18c10 24 20 36 42 48"
            class="stroke-rose-brand/45"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          class="absolute -right-8 -bottom-6 h-16 w-24"
          viewBox="0 0 96 64"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M0 8 C16 8, 16 24, 32 24 S48 40, 64 40 S80 56, 96 56"
            class="animate-stitch stroke-rose-tint"
            stroke-width="1.8"
            stroke-dasharray="6 4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>

      <p class="label tabular">Error 404</p>

      <h1 class="mt-3 font-heading text-step-4 font-bold text-ink-display">
        Oops, we dropped a stitch!
      </h1>

      <p class="mx-auto mt-4 max-w-sm text-step-1 text-ink-muted">
        The page you're looking for seems to have unraveled. Let's get you back on track.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href="/" variant="primary" size="lg">Back to Home</Button>
        <Button href="/gallery/" variant="secondary" size="lg">Browse Gallery</Button>
      </div>
    </div>
  </section>
</Layout>
