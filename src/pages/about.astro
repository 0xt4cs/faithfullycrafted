---
import Layout from '@layouts/Layout.astro';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Divider from '@components/ui/Divider.astro';
import { SITE, SOCIALS } from '@lib/constants';

/**
 * The three process steps used to be a 3-column grid of identical centred
 * cards — three parallel options rather than one sequence. They are now a
 * numbered zig-zag joined by a running-stitch rail, which reads as order:
 * imagine, then create, then deliver.
 *
 * `tint` only ever lands in a `bg-*` utility. The icons themselves carry the
 * meaning of each step, so they take the accessible text rose; the mint icon
 * that shipped here measured 1.59:1.
 */
const steps = [
  {
    n: '01',
    title: 'Imagine',
    body: "Every piece starts with an idea — whether it's your vision or mine, we dream it up together.",
    tint: 'bg-rose-wash',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
  {
    n: '02',
    title: 'Create',
    body: 'Hook in hand, I bring it to life stitch by stitch — with patience, love, and the perfect yarn.',
    tint: 'bg-decor-lavender/12',
    icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  },
  {
    n: '03',
    title: 'Deliver',
    body: 'Wrapped with care and ready to bring joy — your handmade treasure, delivered to your doorstep.',
    tint: 'bg-decor-mint/12',
    icon: 'M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7',
  },
];
---

<Layout
  title="About"
  description="Learn the story behind Faithfully Crafted — Faith's journey from hobby crocheter to handmade artisan in the Philippines."
>
  <!-- Page Header -->
  <header class="pt-12 pb-8 sm:pt-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="font-heading text-step-5 font-bold text-ink-display" data-reveal="up">
        About <span class="font-brand text-rose-text">{SITE.crafter}</span>
      </h1>
      <p
        class="mx-auto mt-4 max-w-lg text-step-1 text-ink-muted"
        data-reveal="up"
        data-reveal-delay="100"
      >
        The heart and hands behind every stitch
      </p>
    </div>
  </header>

  <!-- Story Section -->
  <article class="pb-16 sm:pb-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-start lg:gap-14">
        <div class="mx-auto w-64 shrink-0 sm:w-80" data-reveal="left">
          <Card layout="media">
            <div class="relative aspect-square overflow-hidden rounded-inner bg-surface">
              <img
                src="/faith.jpg"
                alt="Faith, the crafter behind Faithfully Crafted"
                class="h-full w-full object-cover"
                loading="eager"
              />
            </div>
            <p class="pt-4 pb-2 text-center font-brand text-step-2 text-rose-text">
              The face behind the craft
            </p>
          </Card>
        </div>

        <!-- Story -->
        <div class="flex-1 space-y-5" data-reveal="right">
          <h2 class="font-heading text-step-3 font-bold text-ink-display">My Story</h2>
          <p class="text-ink-muted">
            It all started with a gift — a set of crochet hooks from my boyfriend, because I kept
            asking for them. I wanted to try something new, and he believed in me enough to say "go
            for it." My very first creation was a little bee, and I remember being so proud of it,
            showing it to my friends, my mom, and my brothers.
          </p>
          <p class="text-ink-muted">
            What began as a spontaneous hobby quickly grew into something more. Friends started
            pushing me to sell my pieces, even though I was still a beginner. I thought about it,
            took a deep breath, and went for it — and
            <strong class="font-semibold text-ink-display">Faithfully Crafted</strong> was born. The name
            carries a special meaning: "Faith" is my name, and everything I make is crafted
            <em>faithfully</em>, with love and care in every single stitch.
          </p>
          <p class="text-ink-muted">
            I wouldn't be here without my family. My mom buys yarn whenever I need it, my brothers
            got me stands and hooks without ever being asked twice — just pure support, no
            questions, nothing expected in return. And my boyfriend, who started all of this with
            that first gift, has been my biggest cheerleader from day one.
          </p>
          <p class="text-ink-muted">
            Faithfully Crafted celebrated its first anniversary in December 2025, and I still can't
            believe how far this little hobby has come. Based in {SITE.location}, I work from my
            crafting corner turning colorful yarn into amigurumi, keychains, accessories, and custom
            gifts that bring smiles. I believe handmade creations carry something special — a warmth
            and love that you just can't find anywhere else.
          </p>
        </div>
      </div>

      <Divider variant={2} class="my-10" />

      <!-- Process: one sequence, not three parallel options -->
      <section aria-labelledby="process-heading">
        <h2
          id="process-heading"
          class="text-center font-heading text-step-3 font-bold text-ink-display"
          data-reveal="up"
        >
          How a piece comes together
        </h2>

        <ol class="relative mt-12" role="list">
          <!-- running stitch linking the three steps -->
          <span
            class="thread-rail absolute top-6 bottom-6 left-1/2 hidden w-0.5 -translate-x-1/2 md:block"
            aria-hidden="true"></span>

          {
            steps.map((step, i) => (
              <li
                class="relative pb-10 last:pb-0 md:grid md:grid-cols-2 md:gap-x-14 md:pb-8"
                data-reveal="up"
                data-reveal-delay={i * 120}
              >
                <span
                  class="absolute top-7 left-1/2 hidden h-2.5 w-2.5 -translate-x-1/2 rounded-full bg-rose-brand/40 md:block"
                  aria-hidden="true"
                />
                <div
                  class={
                    i % 2 === 0 ? 'md:col-start-1 md:pr-6 md:text-right' : 'md:col-start-2 md:pl-6'
                  }
                >
                  <span class="label tabular block">{step.n}</span>
                  <span
                    class={`mt-3 inline-flex h-14 w-14 items-center justify-center rounded-control ${step.tint}`}
                  >
                    <svg
                      class="h-7 w-7 text-rose-text"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d={step.icon} />
                    </svg>
                  </span>
                  <h3 class="mt-4 font-heading text-step-1 font-bold text-ink-display">
                    {step.title}
                  </h3>
                  <p class="mt-2 text-ink-muted">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <Divider variant={4} class="my-10" />

      <!-- CTA -->
      <div class="text-center" data-reveal="scale">
        <p class="mb-6 text-step-1 text-ink-muted">Want something made just for you?</p>
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href="/order/" variant="primary" size="lg">Let's create together</Button>
          <Button href="/gallery/" variant="secondary" size="lg">Browse my work</Button>
        </div>
      </div>
    </div>
  </article>
</Layout>
