---
import Layout from '@layouts/Layout.astro';
import GalleryGrid from '@components/sections/GalleryGrid.astro';
import { getGalleryItems, getCategoryFacets } from '@lib/gallery';
import { generateCollectionSchema } from '@lib/gallery-schema';

const items = getGalleryItems();
const facets = getCategoryFacets(items);

const description = items.length
  ? `Browse ${items.length} handmade crochet pieces by Faith — amigurumi, keychains, flowers, personalised minis and custom gifts, made in Caloocan, Philippines.`
  : 'Handmade crochet creations by Faith — amigurumi, keychains, flowers and custom gifts, made in Caloocan, Philippines.';
---

<Layout title="Gallery" description={description} jsonLd={generateCollectionSchema(items)}>
  <header class="pb-6 pt-10 sm:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="label" data-reveal="up">The full collection</p>
      <h1
        class="mt-2 font-heading text-step-5 font-bold text-ink-display"
        data-reveal="up"
        data-reveal-delay="60"
      >
        Gallery
      </h1>
      <p class="measure mt-4 text-ink-muted" data-reveal="up" data-reveal-delay="120">
        {
          items.length
            ? `Every piece Faith has finished and photographed, newest first. Filter by what you are after, or search for something specific.`
            : 'New pieces are being photographed and will appear here shortly.'
        }
      </p>
    </div>
  </header>

  <GalleryGrid items={items} facets={facets} />
</Layout>
