---
import Layout from '@layouts/Layout.astro';
import ContactCard from '@components/sections/ContactCard.astro';
import Card from '@components/ui/Card.astro';
import Divider from '@components/ui/Divider.astro';
import { generateFaqSchema } from '@lib/seo';

/**
 * Single source of truth for the FAQ: the <dl> below and the FAQPage
 * structured data are both generated from this array, so the copy a visitor
 * reads and the copy Google indexes can never disagree.
 */
const faqs = [
  {
    question: 'Do you accept custom orders?',
    answer:
      "Absolutely! Custom orders are my favorite. Just send me a message with your idea and I'll give you a quote and timeline.",
  },
  {
    question: 'How long does it take to make a piece?',
    answer:
      'It depends on the complexity! Small amigurumi take 2-3 days, while larger or more detailed pieces can take up to a week or more.',
  },
  {
    question: 'Do you ship nationwide?',
    answer:
      'Yes! I ship within the Philippines. Shipping rates depend on your location. Message me for details.',
  },
  {
    question: 'What payment methods do you accept?',
    answer:
      'I accept GCash, bank transfer, and COD for local meetups. Payment details will be shared once we finalize your order.',
  },
];
---

<Layout
  title="Contact"
  description="Get in touch with Faithfully Crafted — reach Faith on Facebook Messenger or Instagram for custom crochet orders and enquiries."
  jsonLd={generateFaqSchema(faqs)}
>
  <header class="pb-4 pt-10 sm:pt-14">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="label" data-reveal="up">Get in touch</p>
      <h1
        class="mt-2 font-heading text-step-5 font-bold text-ink-display"
        data-reveal="up"
        data-reveal-delay="60"
      >
        Contact
      </h1>
      <p class="measure mt-4 text-ink-muted" data-reveal="up" data-reveal-delay="120">
        Messenger is the quickest way to reach Faith. For a custom piece, the order form asks
        everything she would need to know anyway.
      </p>
    </div>
  </header>

  <ContactCard />

  <Divider variant={3} />

  <!-- FAQ section with semantic description list -->
  <section class="pb-16 sm:pb-20" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2
        id="faq-heading"
        class="mb-10 text-center font-heading text-step-3 font-bold text-ink-display"
        data-reveal="up"
      >
        Common Questions
      </h2>

      <dl class="space-y-4" data-reveal="up" data-reveal-delay="100">
        {
          faqs.map((faq) => (
            <Card layout="text" elevation={1}>
              <dt class="font-heading text-step-1 font-bold text-ink-display">{faq.question}</dt>
              <dd class="mt-2 text-ink-muted">{faq.answer}</dd>
            </Card>
          ))
        }
      </dl>
    </div>
  </section>
</Layout>
