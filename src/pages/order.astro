---
/**
 * Custom order request.
 *
 * Two delivery modes, chosen at build time:
 *
 *  - If PUBLIC_TURNSTILE_SITE_KEY is set, the form posts to /api/order (a
 *    Cloudflare Pages Function) with bot verification.
 *  - If it is not set, the form copies the filled-in request to the clipboard
 *    and opens Messenger, so the reader pastes it into the chat Faith actually
 *    reads.
 *
 * The fallback is the live path today, not a stub. There is no custom domain and
 * no mailbox — faithfullycrafted.ph was never registered — so email delivery is
 * not available from Cloudflare at all, and a mailto: would have opened a mail
 * client addressed to nothing. Messenger is the channel Faith really uses, so the
 * form hands off to it and keeps every field the reader typed. It upgrades to the
 * API with no template change once Turnstile and KV exist.
 */
import Layout from '@layouts/Layout.astro';
import Button from '@components/ui/Button.astro';
import Divider from '@components/ui/Divider.astro';
import { SOCIALS, PIECE_TYPES, BUDGET_RANGES } from '@lib/constants';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const apiMode = Boolean(turnstileSiteKey);

const fieldClass =
  'w-full rounded-control border border-rose-tint bg-card px-3.5 py-2.5 text-step-0 text-ink-body transition-[border-color] duration-[var(--duration-fast)] placeholder:text-ink-subtle focus:border-rose-text focus:outline-none aria-[invalid=true]:border-rose-hover';
const labelClass = 'block font-heading text-step--1 font-semibold text-ink-display';
const errorClass = 'mt-1.5 text-step--1 text-rose-hover';
---

<Layout
  title="Request a custom piece"
  description="Tell Faith what you would like her to crochet — piece type, colours, deadline and budget — and she will reply with a quote and a timeline."
>
  <div class="mx-auto max-w-3xl px-4 pb-24 pt-10 sm:px-6 sm:pt-14 lg:px-8">
    <header>
      <p class="label" data-reveal="up">Commissions</p>
      <h1
        class="mt-2 font-heading text-step-5 font-bold text-ink-display"
        data-reveal="up"
        data-reveal-delay="60"
      >
        Request a custom piece
      </h1>
      <p class="measure mt-4 text-ink-muted" data-reveal="up" data-reveal-delay="120">
        Tell Faith what you have in mind and she will come back with a quote and a timeline. The
        more you can say about colours and who it is for, the closer the first attempt will be.
      </p>
    </header>

    <form id="order-form" class="mt-10" novalidate data-mode={apiMode ? 'api' : 'email'}>
      {
        /* Error summary. Focus moves here on failure so a screen reader
          announces the problems rather than leaving the reader to hunt. */
      }
      <div
        id="order-summary"
        class="mb-6 rounded-card border border-rose-hover bg-rose-wash p-4"
        role="alert"
        tabindex="-1"
        hidden
      >
        <p class="font-heading text-step-0 font-semibold text-ink-display">
          A few things need a look before this can be sent
        </p>
        <ul
          class="mt-2 list-disc space-y-1 pl-5 text-step--1 text-ink-muted"
          id="order-summary-list"
          role="list"
        >
        </ul>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class={labelClass} for="name">Your name</label>
          <input
            class={`${fieldClass} mt-1.5`}
            id="name"
            name="name"
            type="text"
            required
            maxlength="80"
            autocomplete="name"
            aria-describedby="name-error"
          />
          <p class={errorClass} id="name-error" hidden></p>
        </div>

        <div>
          <label class={labelClass} for="contact">Email or Facebook name</label>
          <input
            class={`${fieldClass} mt-1.5`}
            id="contact"
            name="contact"
            type="text"
            required
            maxlength="120"
            autocomplete="email"
            aria-describedby="contact-hint contact-error"
          />
          <p class="mt-1.5 text-step--1 text-ink-subtle" id="contact-hint">
            However you would rather be reached.
          </p>
          <p class={errorClass} id="contact-error" hidden></p>
        </div>

        <div>
          <label class={labelClass} for="pieceType">What would you like made?</label>
          <select
            class={`${fieldClass} mt-1.5`}
            id="pieceType"
            name="pieceType"
            required
            aria-describedby="pieceType-error"
          >
            <option value="">Choose one…</option>
            {PIECE_TYPES.map((type) => <option value={type.value}>{type.label}</option>)}
          </select>
          <p class={errorClass} id="pieceType-error" hidden></p>
        </div>

        <div>
          <label class={labelClass} for="budget">Rough budget</label>
          <select
            class={`${fieldClass} mt-1.5`}
            id="budget"
            name="budget"
            required
            aria-describedby="budget-error"
          >
            <option value="">Choose one…</option>
            {BUDGET_RANGES.map((range) => <option value={range.value}>{range.label}</option>)}
          </select>
          <p class={errorClass} id="budget-error" hidden></p>
        </div>

        <div class="sm:col-span-2">
          <label class={labelClass} for="colors">Colours</label>
          <input
            class={`${fieldClass} mt-1.5`}
            id="colors"
            name="colors"
            type="text"
            required
            maxlength="200"
            placeholder="Sage green and cream, or whatever suits"
            aria-describedby="colors-error"
          />
          <p class={errorClass} id="colors-error" hidden></p>
        </div>

        <div>
          <label class={labelClass} for="deadline"
            >Needed by <span class="font-normal text-ink-subtle">(optional)</span></label
          >
          <input
            class={`${fieldClass} mt-1.5`}
            id="deadline"
            name="deadline"
            type="date"
            aria-describedby="deadline-error"
          />
          <p class={errorClass} id="deadline-error" hidden></p>
        </div>

        <div>
          <label class={labelClass} for="referenceUrl">
            Reference link <span class="font-normal text-ink-subtle">(optional)</span>
          </label>
          <input
            class={`${fieldClass} mt-1.5`}
            id="referenceUrl"
            name="referenceUrl"
            type="url"
            maxlength="500"
            placeholder="https://…"
            aria-describedby="referenceUrl-hint referenceUrl-error"
          />
          <p class="mt-1.5 text-step--1 text-ink-subtle" id="referenceUrl-hint">
            A pin or a post that shows the idea.
          </p>
          <p class={errorClass} id="referenceUrl-error" hidden></p>
        </div>

        <div class="sm:col-span-2">
          <label class={labelClass} for="message">Tell Faith about it</label>
          <textarea
            class={`${fieldClass} mt-1.5 min-h-[8rem] resize-y`}
            id="message"
            name="message"
            required
            maxlength="2000"
            placeholder="Who is it for, how big, and anything that would make it feel right."
            aria-describedby="message-error"></textarea>
          <p class={errorClass} id="message-error" hidden></p>
        </div>
      </div>

      {
        apiMode && (
          <div class="mt-6">
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" />
            <p class={errorClass} id="turnstileToken-error" hidden />
          </div>
        )
      }

      <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <Button type="submit" variant="primary" size="lg" id="order-submit">
          {apiMode ? 'Send request' : 'Copy and open Messenger'}
        </Button>
        <p class="text-step--1 text-ink-subtle" id="order-note">
          {
            apiMode
              ? 'Faith usually replies within a day.'
              : 'Your answers get copied ready to paste, and Messenger opens in a new tab.'
          }
        </p>
      </div>

      <div
        id="order-success"
        class="mt-8 rounded-card border border-rose-tint bg-rose-wash p-6"
        role="status"
        tabindex="-1"
        hidden
      >
        <p class="font-heading text-step-1 font-bold text-ink-display" id="order-success-title">
          {apiMode ? 'Request sent' : 'Copied — now paste it to Faith'}
        </p>
        <p class="mt-2 text-ink-muted" id="order-success-detail">
          {
            apiMode
              ? 'Faith usually replies within a day. If you would rather chase it up sooner, her Messenger is open.'
              : 'Messenger should have opened in a new tab. Paste your request into the chat and send it — Faith usually replies within a day.'
          }
        </p>
        {
          /*
          Shown only by the Messenger path, and only if the clipboard was
          refused. A reader whose browser blocked both the copy and the popup
          still has the exact text in front of them and a link to paste it into.
        */
        }
        <textarea
          id="order-success-text"
          class="mt-4 min-h-[9rem] w-full resize-y rounded-control border border-rose-tint bg-card px-3.5 py-2.5 font-body text-step--1 text-ink-body"
          readonly
          aria-label="Your request, ready to copy"
          hidden></textarea>

        <Button
          href={SOCIALS.facebook.messenger}
          variant="secondary"
          size="md"
          external
          class="mt-5"
        >
          Open Messenger
        </Button>
      </div>

      <div
        id="order-failure"
        class="mt-8 rounded-card border border-rose-hover bg-rose-wash p-6"
        role="alert"
        tabindex="-1"
        hidden
      >
        <p class="font-heading text-step-1 font-bold text-ink-display">That did not go through</p>
        <p class="mt-2 text-ink-muted" id="order-failure-detail"></p>
        <p class="mt-3 text-step--1 text-ink-subtle">
          Nothing is lost — you can send the same details straight to Faith instead.
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <Button href={SOCIALS.facebook.messenger} variant="primary" size="md" external>
            Message Faith
          </Button>
          <Button href={SOCIALS.instagram.url} variant="secondary" size="md" external>
            Or DM on Instagram
          </Button>
        </div>
      </div>
    </form>

    <Divider variant={2} />

    <section aria-labelledby="how-heading">
      <h2 id="how-heading" class="font-heading text-step-3 font-bold text-ink-display">
        How a commission works
      </h2>
      <ol class="mt-6 space-y-5" role="list">
        <li class="flex gap-4">
          <span class="label tabular shrink-0 pt-1">01</span>
          <p class="text-ink-muted">
            You send the details above. Faith replies with a quote, a timeline, and any questions.
          </p>
        </li>
        <li class="flex gap-4">
          <span class="label tabular shrink-0 pt-1">02</span>
          <p class="text-ink-muted">
            Once you are happy, she starts. Small pieces take two to three days; larger or more
            detailed ones can take a week or more.
          </p>
        </li>
        <li class="flex gap-4">
          <span class="label tabular shrink-0 pt-1">03</span>
          <p class="text-ink-muted">
            She sends a photo before it is wrapped, then it ships anywhere in the Philippines.
            GCash, bank transfer, or cash on local meetups.
          </p>
        </li>
      </ol>
    </section>
  </div>

  {
    apiMode && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
    )
  }
</Layout>

<script is:inline define:vars={{ messengerUrl: SOCIALS.facebook.messenger }}>
  function initOrderForm() {
    const form = document.getElementById('order-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    const mode = form.dataset.mode;
    const submit = document.getElementById('order-submit');
    const summary = document.getElementById('order-summary');
    const summaryList = document.getElementById('order-summary-list');
    const success = document.getElementById('order-success');
    const successDetail = document.getElementById('order-success-detail');
    const successText = document.getElementById('order-success-text');
    const failure = document.getElementById('order-failure');
    const failureDetail = document.getElementById('order-failure-detail');

    const FIELDS = [
      'name',
      'contact',
      'pieceType',
      'budget',
      'colors',
      'deadline',
      'referenceUrl',
      'message',
    ];

    function showError(field, message) {
      const input = document.getElementById(field);
      const errorEl = document.getElementById(`${field}-error`);
      if (input) input.setAttribute('aria-invalid', 'true');
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }
    }

    function clearErrors() {
      FIELDS.concat('turnstileToken').forEach((field) => {
        const input = document.getElementById(field);
        const errorEl = document.getElementById(`${field}-error`);
        if (input) input.removeAttribute('aria-invalid');
        if (errorEl) {
          errorEl.hidden = true;
          errorEl.textContent = '';
        }
      });
      if (summary) summary.hidden = true;
      if (summaryList) summaryList.textContent = '';
      if (failure) failure.hidden = true;
    }

    function renderErrors(errors) {
      Object.entries(errors).forEach(([field, message]) => showError(field, message));

      if (summary && summaryList) {
        summaryList.textContent = '';
        Object.values(errors).forEach((message) => {
          const li = document.createElement('li');
          li.textContent = message;
          summaryList.appendChild(li);
        });
        summary.hidden = false;
        summary.focus();
      }
    }

    function readValues() {
      const values = {};
      FIELDS.forEach((field) => {
        const input = document.getElementById(field);
        values[field] = input ? input.value.trim() : '';
      });
      return values;
    }

    /**
     * Client-side validation mirrors the server rules so the reader gets an
     * answer immediately. The server revalidates everything regardless — this
     * is a courtesy, never the gate.
     */
    function validate(values) {
      const errors = {};

      if (values.name.length < 2) {
        errors.name = 'Add your name so Faith knows who she is talking to.';
      }
      if (values.contact.length < 3) {
        errors.contact = 'Add an email or Facebook name so Faith can reply.';
      } else if (
        values.contact.includes('@') &&
        !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(values.contact)
      ) {
        errors.contact = 'That email address looks incomplete.';
      }
      if (!values.pieceType) errors.pieceType = 'Pick the kind of piece you would like.';
      if (!values.budget)
        errors.budget = 'Pick a rough budget so Faith can suggest something that fits.';
      if (values.colors.length < 2) {
        errors.colors = 'Even "you choose" helps — say something about colours.';
      }
      if (values.message.length < 5) {
        errors.message = 'Tell Faith a little about what you would like.';
      }
      if (values.deadline) {
        const when = new Date(values.deadline);
        if (Number.isNaN(when.getTime())) {
          errors.deadline = 'That date did not read properly.';
        } else {
          const today = new Date();
          today.setHours(0, 0, 0, 0);
          if (when < today) errors.deadline = 'That date has already passed.';
        }
      }
      if (values.referenceUrl) {
        try {
          const url = new URL(values.referenceUrl);
          if (url.protocol !== 'http:' && url.protocol !== 'https:') {
            errors.referenceUrl = 'Links need to start with http or https.';
          }
        } catch {
          errors.referenceUrl = 'That link did not read properly.';
        }
      }

      return errors;
    }

    function labelFor(field) {
      const el = document.getElementById(field);
      const select = el && el.tagName === 'SELECT' ? el.options[el.selectedIndex] : null;
      return select ? select.textContent.trim() : el ? el.value.trim() : '';
    }

    /** The request as a message Faith can read at a glance in a chat. */
    function composeMessage(values) {
      return [
        'Custom order request',
        '',
        `Name: ${values.name}`,
        `Best reached at: ${values.contact}`,
        `Piece: ${labelFor('pieceType')}`,
        `Budget: ${labelFor('budget')}`,
        `Colours: ${values.colors}`,
        values.deadline ? `Needed by: ${values.deadline}` : null,
        values.referenceUrl ? `Reference: ${values.referenceUrl}` : null,
        '',
        values.message,
      ]
        .filter((line) => line !== null)
        .join(String.fromCharCode(10));
    }

    /**
     * Copy via the async Clipboard API, falling back to a hidden textarea and
     * execCommand. The fallback matters here: navigator.clipboard is unavailable
     * on insecure origins and in some in-app browsers, and much of Faith's
     * audience arrives through links opened inside the Facebook app.
     */
    async function copyText(text) {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch {
        /* fall through to the legacy path */
      }

      try {
        const scratch = document.createElement('textarea');
        scratch.value = text;
        scratch.setAttribute('readonly', '');
        scratch.style.position = 'fixed';
        scratch.style.top = '-1000px';
        document.body.appendChild(scratch);
        scratch.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(scratch);
        return ok;
      } catch {
        return false;
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      const values = readValues();
      const errors = validate(values);

      if (Object.keys(errors).length > 0) {
        renderErrors(errors);
        return;
      }

      if (mode === 'email') {
        const text = composeMessage(values);
        const copied = await copyText(text);

        // New tab, so the filled-in form is still here if they come back.
        // Popup blockers can refuse this, which is why the panel below also
        // shows the text itself and a plain link.
        window.open(messengerUrl, '_blank', 'noopener');

        if (successDetail) {
          successDetail.textContent = copied
            ? 'Messenger should have opened in a new tab. Paste your request into the chat and send it. Faith usually replies within a day.'
            : 'Messenger should have opened in a new tab. Your browser would not let the page copy for you, so copy the text below into the chat.';
        }
        if (successText) {
          successText.value = text;
          successText.hidden = false;
        }
        if (success) {
          success.hidden = false;
          success.focus();
        }
        return;
      }

      const tokenField = form.querySelector('[name="cf-turnstile-response"]');
      const turnstileToken = tokenField ? tokenField.value : '';
      if (!turnstileToken) {
        renderErrors({ turnstileToken: 'Please complete the security check below.' });
        return;
      }

      submit?.setAttribute('aria-busy', 'true');
      submit?.setAttribute('disabled', '');

      try {
        const response = await fetch('/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...values, turnstileToken }),
        });

        const payload = await response.json().catch(() => ({}));

        if (response.ok && payload.ok) {
          form.querySelectorAll('input, select, textarea').forEach((el) => {
            if (el.type !== 'hidden') el.value = '';
          });
          if (success) {
            success.hidden = false;
            success.focus();
          }
          return;
        }

        if (payload.errors) {
          renderErrors(payload.errors);
        } else if (failure && failureDetail) {
          failureDetail.textContent = payload.error || 'The request could not be sent just now.';
          failure.hidden = false;
          failure.focus();
        }

        // Turnstile tokens are single use, so any failed attempt needs a fresh one.
        if (window.turnstile) window.turnstile.reset();
      } catch {
        if (failure && failureDetail) {
          failureDetail.textContent = 'The connection dropped before the request was sent.';
          failure.hidden = false;
          failure.focus();
        }
        if (window.turnstile) window.turnstile.reset();
      } finally {
        submit?.removeAttribute('aria-busy');
        submit?.removeAttribute('disabled');
      }
    });
  }

  initOrderForm();
  document.addEventListener('astro:after-swap', initOrderForm);
</script>
