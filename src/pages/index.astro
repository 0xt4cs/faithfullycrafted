---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.astro';
import FeaturedWorks from '@components/sections/FeaturedWorks.astro';
import AboutSnippet from '@components/sections/AboutSnippet.astro';
import CTABanner from '@components/sections/CTABanner.astro';
import Divider from '@components/ui/Divider.astro';
import { getGalleryItems } from '@lib/gallery';

const items = getGalleryItems();
---

<Layout preloadImage="/faith-640.avif">
  <Hero pieceCount={items.length} />
  <FeaturedWorks items={items} />
  <Divider variant={3} />
  <AboutSnippet />
  <Divider variant={1} />
  <CTABanner />
</Layout>
