---
import { NAV_ITEMS, SITE } from '@lib/constants';

const path = Astro.url.pathname;
const isHome = path === '/';

/** A nav item is current if it is the exact page, or an ancestor of it. */
function isCurrent(href: string) {
  if (href === '/') return isHome;
  return path === href || path.startsWith(href);
}

const mainNav = NAV_ITEMS.filter((item) => item.href !== '/order/');
const orderItem = NAV_ITEMS.find((item) => item.href === '/order/');
---

{
  /*
  Sentinel for the scroll state. An IntersectionObserver watching this beats a
  scroll listener: no work on the main thread per scroll event, and no
  requestAnimationFrame throttling to get wrong.
*/
}
<div id="nav-sentinel" aria-hidden="true" class="absolute top-0 h-20 w-px"></div>

<header
  id="main-header"
  class="fixed left-1/2 z-40 -translate-x-1/2"
  data-home={isHome ? '' : undefined}
>
  <nav
    id="nav-inner"
    aria-label="Main"
    class="mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between gap-6 px-5 sm:px-7 lg:px-9"
  >
    <a
      href="/"
      class="nav-brand no-underline-reset group flex shrink-0 items-center gap-2"
      aria-label={`${SITE.name} — home`}
    >
      <span
        class="font-brand text-step-2 text-rose-text transition-transform duration-[var(--duration-base)] ease-soft group-hover:scale-[1.03]"
      >
        {SITE.name}
      </span>
    </a>

    <ul class="hidden items-center gap-7 md:flex lg:gap-9" role="list">
      {
        mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="nav-link no-underline-reset relative py-1 font-heading text-step-0 font-semibold text-ink-body transition-colors duration-[var(--duration-fast)] hover:text-rose-text"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      {
        orderItem && (
          <li>
            <a
              href={orderItem.href}
              aria-current={isCurrent(orderItem.href) ? 'page' : undefined}
              class="no-underline-reset inline-flex min-h-[40px] items-center rounded-control bg-rose-text px-4 py-2 font-heading text-step--1 font-semibold text-white shadow-1 transition-[background-color,box-shadow,transform] duration-[var(--duration-base)] ease-soft hover:-translate-y-px hover:bg-rose-hover hover:shadow-2"
            >
              {orderItem.label} a piece
            </a>
          </li>
        )
      }
    </ul>

    <button
      id="mobile-menu-btn"
      class="relative flex h-12 w-12 shrink-0 items-center justify-center rounded-control transition-colors duration-[var(--duration-fast)] hover:bg-rose-wash md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="relative flex h-[18px] w-[22px] flex-col justify-between">
        <span
          class="hamburger-bar block h-[2px] w-full origin-center rounded-full bg-ink-body transition-all duration-[var(--duration-base)] ease-soft"
        ></span>
        <span
          class="hamburger-bar block h-[2px] w-full origin-center rounded-full bg-ink-body transition-all duration-[var(--duration-base)] ease-soft"
        ></span>
        <span
          class="hamburger-bar block h-[2px] w-full origin-center rounded-full bg-ink-body transition-all duration-[var(--duration-base)] ease-soft"
        ></span>
      </span>
    </button>
  </nav>
</header>

{!isHome && <div class="h-[5.5rem]" />}

<div
  id="mobile-menu"
  class="pointer-events-none fixed inset-0 z-[90] opacity-0 transition-opacity duration-[var(--duration-base)] md:hidden"
  aria-hidden="true"
  inert
>
  <div
    class="absolute inset-0 bg-gradient-to-b from-cream/95 via-page/97 to-surface/97 backdrop-blur-2xl"
  >
  </div>

  <div class="relative flex h-full flex-col items-center justify-center gap-6 px-6">
    <span class="mobile-nav-item font-brand text-step-5 text-rose-text" style="--nav-i:0">
      {SITE.name}
    </span>

    {
      NAV_ITEMS.map((item, i) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class="mobile-nav-item no-underline-reset font-heading text-step-3 font-semibold text-ink-body transition-colors hover:text-rose-text aria-[current=page]:text-rose-text"
          style={`--nav-i:${i + 1}`}
        >
          {item.label}
        </a>
      ))
    }

    <div class="mobile-nav-item mt-2" style={`--nav-i:${NAV_ITEMS.length + 1}`} aria-hidden="true">
      <svg class="h-10 w-10 animate-spin-slow" viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="15" class="fill-rose-brand/12"></circle>
        <path
          d="M11 26c5-10 10-12 12-22M14 9c4 10 8 14 16 18"
          class="stroke-rose-brand/45"
          stroke-width="1.8"
          stroke-linecap="round"></path>
      </svg>
    </div>
  </div>
</div>

<style>
  /* On the home page the brand is hidden at the top of the scroll — the hero
     already says the name in large type, so repeating it in the nav is
     redundant. It fades in with the island. */
  .nav-brand {
    transition:
      opacity 0.35s ease,
      transform 0.35s var(--ease-soft);
  }

  #main-header[data-home] .nav-brand {
    opacity: 0;
    transform: translateY(-6px) scale(0.96);
    pointer-events: none;
  }

  #main-header[data-home].nav-island .nav-brand {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* Active page: a stitched underline, drawn rather than a solid rule. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0;
    background-image: linear-gradient(to right, var(--color-rose-text) 0 5px, transparent 5px 9px);
    background-size: 9px 2px;
    background-repeat: repeat-x;
    transition: width 0.3s var(--ease-soft);
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    width: 100%;
  }

  .nav-link[aria-current='page'] {
    color: var(--color-rose-text);
  }

  [aria-expanded='true'] .hamburger-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  [aria-expanded='true'] .hamburger-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  [aria-expanded='true'] .hamburger-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-nav-item {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.35s ease,
      transform 0.4s var(--ease-soft);
    transition-delay: calc(var(--nav-i, 0) * 60ms);
  }

  #mobile-menu.menu-open .mobile-nav-item {
    opacity: 1;
    transform: translateY(0);
  }

  #main-header {
    top: 16px;
    width: calc(100% - 32px);
    border-radius: 9999px;
    background: transparent;
    /* Same width in both states so toggling the island causes no layout shift. */
    border: 2px dashed transparent;
    transition:
      background-color 0.4s ease-in-out,
      backdrop-filter 0.4s ease-in-out,
      border-color 0.4s ease-in-out,
      box-shadow 0.4s ease-in-out;
  }

  @media (min-width: 768px) {
    #main-header {
      width: calc(100% - 48px);
      max-width: 76rem;
    }
  }

  /* The dashed edge stays — it reads as a running stitch around the pill,
     which is the most on-brand detail in the whole nav, and it is the thing
     that stops the island looking like generic glassmorphism.
     Two changes from the original: 2px instead of 3px, and the accessible rose
     at a higher alpha instead of #e8669a at 40%, which was faint enough to
     look unintentional. Combined with the inner highlight it now reads as
     stitched glass rather than an unfinished outline. */
  #main-header.nav-island {
    background: rgb(255 245 247 / 0.72);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-color: rgb(191 47 98 / 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.75),
      var(--shadow-2);
  }

  @supports not (backdrop-filter: blur(1px)) {
    #main-header.nav-island {
      background: rgb(255 245 247 / 0.96);
    }
  }
</style>

<script>
  function initHeader() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const header = document.getElementById('main-header');
    const sentinel = document.getElementById('nav-sentinel');
    if (!btn || !menu || !header) return;

    let menuOpen = false;

    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    function openMenu() {
      menuOpen = true;
      menu!.removeAttribute('inert');
      menu!.classList.remove('opacity-0', 'pointer-events-none');
      menu!.classList.add('opacity-100', 'pointer-events-auto', 'menu-open');
      btn!.setAttribute('aria-expanded', 'true');
      btn!.setAttribute('aria-label', 'Close menu');
      menu!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      focusables()[0]?.focus();
    }

    function closeMenu(returnFocus = true) {
      menuOpen = false;
      menu!.classList.add('opacity-0', 'pointer-events-none');
      menu!.classList.remove('opacity-100', 'pointer-events-auto', 'menu-open');
      btn!.setAttribute('aria-expanded', 'false');
      btn!.setAttribute('aria-label', 'Open menu');
      menu!.setAttribute('aria-hidden', 'true');
      menu!.setAttribute('inert', '');
      document.body.style.overflow = '';
      if (returnFocus) btn!.focus();
    }

    btn.addEventListener('click', () => (menuOpen ? closeMenu() : openMenu()));
    menu
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', () => closeMenu(false)));

    document.addEventListener('keydown', (e) => {
      if (!menuOpen) return;

      if (e.key === 'Escape') {
        closeMenu();
        return;
      }

      // Keep focus inside the open overlay. Without this, tabbing walks
      // through the page behind the menu.
      if (e.key === 'Tab') {
        const items = focusables();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    if (sentinel && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => header.classList.toggle('nav-island', !entry.isIntersecting),
        { threshold: 0 },
      );
      observer.observe(sentinel);
    } else {
      // Only reached on browsers without IntersectionObserver.
      header.classList.add('nav-island');
    }
  }

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
