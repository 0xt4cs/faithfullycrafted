---
/**
 * AboutSnippet
 *
 * The photo used to sit in a five-element stack: two offset rotated colour
 * plates, a rotated white frame, a washi-tape strip, and the image. It is now
 * one `Card` with a concentric inner radius, so the picture of Faith is the
 * thing you look at.
 */
import Card from '@components/ui/Card.astro';
import { SITE } from '@lib/constants';
---

<section class="bg-surface/40 py-16 sm:py-20" aria-label="About the crafter">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-10 lg:flex-row lg:gap-16">
      <div class="mx-auto w-56 shrink-0 sm:w-72" data-reveal="left">
        <Card layout="media">
          <div class="relative aspect-square overflow-hidden rounded-inner bg-surface">
            <img
              src="/faith.jpg"
              alt="Faith, the crafter behind Faithfully Crafted"
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
          <p class="pt-3 pb-1 text-center font-brand text-step-2 text-rose-text">Hello there!</p>
        </Card>
      </div>

      <!-- Text -->
      <div class="flex-1 text-center lg:text-left" data-reveal="right">
        <h2 class="font-heading text-step-4 font-bold text-ink-display">
          Meet <span class="font-brand text-rose-text">{SITE.crafter}</span>
        </h2>
        <p class="measure mx-auto mt-4 text-ink-muted lg:mx-0">
          Hi, I'm Faith! What started with a gift of crochet hooks from my boyfriend turned into a
          passion I never expected. My very first creation was a little bee — and from that moment,
          I was hooked. With the support of my family and friends, Faithfully Crafted was born in
          late 2024.
        </p>
        <p class="measure mx-auto mt-3 text-ink-muted lg:mx-0">
          Based in {SITE.location}, I turn colorful yarn into amigurumi, keychains, and custom gifts
          — each one made faithfully, with love in every stitch.
        </p>
        <a
          href="/about/"
          class="group mt-6 inline-flex items-center gap-2 font-heading font-semibold"
        >
          Read my story
          <svg
            class="h-4 w-4 transition-transform duration-[var(--duration-fast)] ease-soft group-hover:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
