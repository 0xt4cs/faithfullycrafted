---
/**
 * CTABanner
 *
 * Previously: a gradient wash, two blurred floating blobs, a masked
 * torn-paper container, a washi-tape strip and a one-degree tilt — five
 * decorations competing for one sentence and two buttons.
 *
 * Now the craft feeling comes from material instead: a crochet V-stitch
 * field behind a calm card. Nothing here animates, so it needs no
 * reduced-motion escape hatch.
 */
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import { SOCIALS } from '@lib/constants';
---

<section class="stitch-field bg-surface/50 py-16 sm:py-24" aria-label="Custom order call to action">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8" data-reveal="scale">
    <Card layout="text" class="text-center">
      <h2 class="font-heading text-step-5 font-bold text-ink-display">Want a custom piece?</h2>
      <p class="mx-auto mt-4 max-w-md text-step-1 text-ink-muted">
        I'd love to create something special just for you. Reach out and let's bring your idea to
        life, one stitch at a time.
      </p>
      {
        /*
        The order page leads, because it asks the questions Faith would have to
        ask anyway — piece, colours, size, deadline, budget — so the first reply
        can be a quote rather than a round of questions. Messenger stays as the
        informal route for people who would rather just chat.
      */
      }
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href="/order/" variant="primary" size="lg">Request a custom piece</Button>
        <Button href={SOCIALS.facebook.messenger} variant="secondary" size="lg" external>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 0C5.373 0 0 4.974 0 11.111c0 3.498 1.744 6.614 4.469 8.654V24l4.088-2.242c1.092.3 2.246.464 3.443.464 6.627 0 12-4.975 12-11.111S18.627 0 12 0z"
            ></path>
          </svg>
          Chat on Messenger
        </Button>
      </div>
    </Card>
  </div>
</section>
