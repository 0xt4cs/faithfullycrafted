---
/**
 * GalleryGrid
 *
 * Rewritten from a CSS `columns` masonry with a Load More button.
 *
 * Why the layout changed: `columns` lays items out top-to-bottom per column,
 * so the visual order did not match the DOM order — a keyboard or screen
 * reader user traversed the gallery in a different sequence to a sighted one.
 * Revealing hidden items also reflowed every column, so the page jumped under
 * the reader's cursor. Measuring the corpus settled the replacement: 80% of
 * Faith's photos are already square (720x720 straight from Facebook), so a
 * uniform square grid is honest to the content, keeps DOM order, and has no
 * reflow at all.
 *
 * Filtering is progressive enhancement. Every piece is rendered as static
 * HTML, so with JavaScript disabled the full gallery is still browsable and
 * every piece page is still linked. JavaScript only adds filtering, search,
 * and the initial cap.
 */
import type { CategoryFacet, GalleryItem } from '@typedefs/index';
import Card from '@components/ui/Card.astro';
import Chip from '@components/ui/Chip.astro';
import GalleryImage from '@components/ui/GalleryImage.astro';
import EmptyState from '@components/ui/EmptyState.astro';

interface Props {
  items: GalleryItem[];
  facets: CategoryFacet[];
  /** How many to show before the reader asks for more. */
  initialCount?: number;
  batchSize?: number;
}

const { items, facets, initialCount = 48, batchSize = 48 } = Astro.props;

/**
 * Inline the low-quality placeholder only for images near the top of the page.
 * Each one is ~220 bytes of base64; at 291 pieces that is 65 kB of HTML spent
 * on placeholders nobody scrolled to. Below the fold the surface tint is
 * enough, since those images are lazy anyway.
 */
const LQIP_LIMIT = 24;
---

<section class="pb-24" id="gallery-section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {
      items.length > 0 && (
        <div class="mb-10 flex flex-col gap-5">
          {/*
            One horizontally scrollable row on phones, wrapping from `sm` up.
            Nine categories wrapped to four stacked rows at 390px, pushing the
            first piece most of a screen down the page.
          */}
          <div
            class="scrollbar-hide -mx-4 flex snap-x items-center gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:pb-0"
            role="group"
            aria-label="Filter by category"
            id="gallery-filters"
          >
            <Chip label="Everything" value="all" count={items.length} active />
            {facets.map((facet) => (
              <Chip label={facet.label} value={facet.id} count={facet.count} />
            ))}
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="relative w-full sm:max-w-sm">
              <label for="gallery-search" class="sr-only">
                Search pieces
              </label>
              <svg
                class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="9" cy="9" r="6" class="stroke-ink-subtle" />
                <path d="M13.5 13.5L17 17" class="stroke-ink-subtle" />
              </svg>
              <input
                type="search"
                id="gallery-search"
                placeholder="Search for stars, keychains, Totoro…"
                autocomplete="off"
                class="w-full rounded-control border border-rose-tint bg-card py-2.5 pl-10 pr-3 text-step-0 text-ink-body transition-[border-color,box-shadow] duration-[var(--duration-fast)] placeholder:text-ink-subtle focus:border-rose-text focus:outline-none"
              />
            </div>

            <p class="label" id="gallery-count" aria-live="polite">
              <span class="tabular" id="gallery-shown">
                {Math.min(initialCount, items.length)}
              </span>
              {' of '}
              <span class="tabular" id="gallery-total">
                {items.length}
              </span>
              {' pieces'}
            </p>
          </div>
        </div>
      )
    }

    {
      items.length === 0 ? (
        <EmptyState kind="gallery" />
      ) : (
        <>
          <ul
            id="gallery-grid"
            class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4"
            role="list"
          >
            {items.map((item, i) => (
              <li
                class="gallery-item"
                data-index={String(i)}
                data-category={item.category}
                data-search={`${item.title} ${item.categoryLabel} ${item.tags.join(' ')}`.toLowerCase()}
                data-reveal={i < initialCount ? 'up' : undefined}
                data-reveal-delay={String((i % 4) * 70)}
              >
                {/*
                  Stretched-link pattern. The card needs two actions — go to
                  the piece page, and expand in place — and a <button> cannot
                  be nested inside an <a>. So the card is a plain container, a
                  positioned link covers it, and the expand button sits above
                  that link. Both stay reachable by keyboard.
                */}
                <Card class="group/card relative h-full">
                  <GalleryImage
                    item={item}
                    wrapperClass="rounded-inner"
                    sizes="(min-width: 1024px) 18rem, (min-width: 768px) 30vw, 45vw"
                    loading={i < 8 ? 'eager' : 'lazy'}
                    fetchpriority={i < 4 ? 'high' : undefined}
                    maxWidth={800}
                    aspect="square"
                    showPlaceholder={i < LQIP_LIMIT}
                  />
                  <div class="px-1.5 pb-1 pt-3">
                    <p class="line-clamp-2 font-heading text-step--1 font-semibold text-ink-display sm:text-step-0">
                      {item.title}
                    </p>
                    {item.dateLabel && <p class="label mt-1">{item.dateLabel}</p>}
                  </div>

                  <a href={item.href} class="absolute inset-0 z-10 rounded-card">
                    <span class="sr-only">{`View ${item.title}`}</span>
                  </a>

                  <button
                    type="button"
                    class="absolute right-3 top-3 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-card/85 text-ink-body opacity-0 shadow-1 backdrop-blur-sm transition-[opacity,background-color] duration-[var(--duration-fast)] hover:bg-card focus-visible:opacity-100 group-hover/card:opacity-100"
                    aria-label={`Expand ${item.title}`}
                    data-lightbox-trigger
                    data-lightbox-src={`/gallery/${item.hash}-800.jpg`}
                    data-lightbox-alt={item.alt}
                    data-lightbox-caption={item.title}
                    data-lightbox-href={item.href}
                  >
                    <svg
                      viewBox="0 0 20 20"
                      class="h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M8 3H3v5M12 17h5v-5M3 3l6 6M17 17l-6-6" />
                    </svg>
                  </button>
                </Card>
              </li>
            ))}
          </ul>

          <div id="gallery-no-results" hidden>
            <EmptyState kind="filter" />
          </div>

          <div class="mt-12 flex flex-col items-center gap-3" id="gallery-more-wrap" hidden>
            <button
              id="gallery-load-more"
              type="button"
              class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-control bg-rose-text px-8 py-3 font-heading text-step-0 font-semibold text-white shadow-2 transition-[background-color,box-shadow,transform] duration-[var(--duration-base)] ease-soft hover:-translate-y-px hover:bg-rose-hover hover:shadow-3 active:translate-y-0 active:scale-[0.98]"
            >
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle
                  cx="8"
                  cy="8"
                  r="6"
                  stroke="currentColor"
                  stroke-width="1.8"
                  opacity="0.45"
                />
                <path
                  d="M8 5v6M5 8h6"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
              </svg>
              Show more
            </button>
          </div>
        </>
      )
    }
  </div>
</section>

<script is:inline define:vars={{ initialCount, batchSize }}>
  function initGallery() {
    const grid = document.getElementById('gallery-grid');
    if (!grid) return;

    const items = Array.from(grid.querySelectorAll('.gallery-item'));
    const filters = document.getElementById('gallery-filters');
    const search = document.getElementById('gallery-search');
    const shownEl = document.getElementById('gallery-shown');
    const totalEl = document.getElementById('gallery-total');
    const noResults = document.getElementById('gallery-no-results');
    const moreWrap = document.getElementById('gallery-more-wrap');
    const moreBtn = document.getElementById('gallery-load-more');

    let category = 'all';
    let query = '';
    let visibleCap = initialCount;

    function matches(el) {
      if (category !== 'all' && el.dataset.category !== category) return false;
      if (query && !(el.dataset.search || '').includes(query)) return false;
      return true;
    }

    function apply() {
      const matched = items.filter(matches);

      // When the reader is filtering or searching they asked a question, so
      // show every answer rather than making them press "show more" again.
      const cap = category === 'all' && !query ? visibleCap : matched.length;

      items.forEach((el) => {
        el.hidden = true;
      });
      matched.slice(0, cap).forEach((el) => {
        el.hidden = false;
      });

      const shownCount = Math.min(cap, matched.length);
      if (shownEl) shownEl.textContent = String(shownCount);
      if (totalEl) totalEl.textContent = String(matched.length);
      if (noResults) noResults.hidden = matched.length > 0;
      if (moreWrap) moreWrap.hidden = shownCount >= matched.length;

      // Newly revealed images need their fade-in and error handlers bound.
      document.dispatchEvent(new CustomEvent('gallery:items-added'));
    }

    filters?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-filter]');
      if (!button) return;
      category = button.dataset.filter || 'all';
      filters.querySelectorAll('[data-filter]').forEach((el) => {
        const active = el === button;
        el.setAttribute('aria-pressed', active ? 'true' : 'false');
        el.classList.toggle('border-rose-text', active);
        el.classList.toggle('bg-rose-text', active);
        el.classList.toggle('text-white', active);
        el.classList.toggle('border-rose-tint', !active);
        el.classList.toggle('bg-card', !active);
        el.classList.toggle('text-ink-muted', !active);
      });
      apply();
    });

    let debounce;
    search?.addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(() => {
        query = search.value.trim().toLowerCase();
        apply();
      }, 140);
    });

    moreBtn?.addEventListener('click', () => {
      visibleCap += batchSize;
      apply();
      // Move focus to the first newly shown card so keyboard users are not
      // dropped back at the top of the document.
      const firstNew = items.filter((el) => !el.hidden)[visibleCap - batchSize];
      firstNew?.querySelector('a')?.focus({ preventScroll: true });
    });

    apply();
  }

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
