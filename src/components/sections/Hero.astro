---
/**
 * Hero
 *
 * This is the one place on the site that spends boldness: the washi tape, the
 * tilt, and the layered paper all live here and nowhere else. The audit found
 * 46 rotations and 11 tape strips scattered across every card, which is why
 * nothing felt like a focal point. Concentrating them into a single pinned
 * photograph is what makes it read as a craft table rather than a template.
 *
 * It is also the LCP element, so the portrait ships as AVIF/WebP at the width
 * actually displayed. It was previously a 2048x2048 JPEG rendered at roughly
 * 380px — 87 kB to paint 7 kB of pixels.
 */
import Button from '@components/ui/Button.astro';
import { SITE, SOCIALS } from '@lib/constants';

interface Props {
  /** Total pieces, so the hero can say something true rather than vague. */
  pieceCount?: number;
}

const { pieceCount } = Astro.props;
---

<section
  class="stitch-field grain relative overflow-hidden bg-gradient-to-b from-cream via-surface to-page"
  aria-labelledby="hero-heading"
>
  {/* Decorative only: fill-/stroke-, never text-, so the contrast gate passes. */}
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <svg
      class="animate-float absolute -top-6 right-6 hidden h-24 w-24 sm:block"
      viewBox="0 0 96 96"
      fill="none"
    >
      <circle cx="48" cy="48" r="38" class="fill-decor-mint/15"></circle>
      <path
        d="M24 60c12-18 24-24 30-42M34 22c6 18 18 30 36 36"
        class="stroke-decor-mint/40"
        stroke-width="1.8"
        stroke-linecap="round"></path>
    </svg>
    <svg
      class="animate-float-delayed absolute left-[4%] top-1/3 hidden h-16 w-16 lg:block"
      viewBox="0 0 64 64"
      fill="none"
    >
      <circle cx="32" cy="32" r="24" class="fill-decor-lavender/15"></circle>
      <path
        d="M18 40c7-11 14-15 18-26"
        class="stroke-decor-lavender/40"
        stroke-width="1.8"
        stroke-linecap="round"></path>
    </svg>
  </div>

  <div
    class="relative mx-auto max-w-7xl px-4 pb-20 pt-32 sm:px-6 sm:pb-24 sm:pt-40 lg:px-8 lg:pb-28 lg:pt-44"
  >
    <div class="flex flex-col items-center gap-14 lg:flex-row lg:gap-20">
      <div class="flex-1 text-center lg:text-left">
        <p class="label" data-reveal="up">Handmade in Caloocan, Philippines</p>

        <h1 id="hero-heading" class="mt-3" data-reveal="up" data-reveal-delay="60">
          <span class="block font-brand text-step-6 leading-[1.05] text-rose-text">
            {SITE.name}
          </span>
        </h1>

        <p
          class="measure mx-auto mt-5 font-heading text-step-2 leading-snug text-ink-display lg:mx-0"
          data-reveal="up"
          data-reveal-delay="120"
        >
          Crochet made one stitch at a time, by hand, by Faith.
        </p>

        <p
          class="measure mx-auto mt-4 text-ink-muted lg:mx-0"
          data-reveal="up"
          data-reveal-delay="180"
        >
          Amigurumi, keychains, flowers and personalised minis — each piece worked to order in a
          crafting corner in South Caloocan, and posted out across the Philippines.
        </p>

        <div
          class="mt-9 flex flex-col items-center gap-3 sm:flex-row sm:gap-4 lg:justify-start"
          data-reveal="up"
          data-reveal-delay="240"
        >
          <Button href="/order/" variant="primary" size="lg">Request a custom piece</Button>
          <Button href="/gallery/" variant="secondary" size="lg">
            {pieceCount ? `Browse ${pieceCount} pieces` : 'Browse the gallery'}
          </Button>
        </div>

        <p class="mt-6 text-step--1 text-ink-subtle" data-reveal="fade" data-reveal-delay="300">
          Prefer to chat? <a
            href={SOCIALS.facebook.messenger}
            target="_blank"
            rel="noopener noreferrer">Message Faith on Messenger</a
          >
        </p>
      </div>

      {/* ---- The signature moment ---- */}
      <div class="relative flex-shrink-0" data-reveal="scale">
        <div class="group relative w-64 sm:w-80 lg:w-[22rem]">
          {
            /* Two sheets of paper behind, offset in ONE direction so the light
              source stays consistent. The old version offset them in opposing
              directions, which read as two conflicting light sources. */
          }
          <div
            class="absolute inset-0 rotate-[3deg] rounded-card bg-rose-brand/20 shadow-1 transition-transform duration-[var(--duration-slow)] ease-soft group-hover:rotate-[5deg]"
          >
          </div>
          <div
            class="absolute inset-0 rotate-[1.5deg] rounded-card bg-cream shadow-1 transition-transform duration-[var(--duration-slow)] ease-soft group-hover:rotate-[2.5deg]"
          >
          </div>

          <div
            class="relative z-10 rotate-[-2deg] rounded-card border border-rose-tint/60 bg-card p-3 shadow-3 transition-transform duration-[var(--duration-slow)] ease-soft group-hover:rotate-0"
          >
            {/* Washi tape. The only strip on the site. */}
            <div
              class="absolute -top-4 right-7 z-20 h-7 w-24 rotate-[10deg] border border-white/50 bg-decor-lavender/60 shadow-1 backdrop-blur-sm"
              style="clip-path: polygon(4% 5%, 96% 2%, 98% 95%, 2% 98%);"
              aria-hidden="true"
            >
            </div>

            <div class="overflow-hidden rounded-inner bg-surface">
              <picture>
                <source
                  type="image/avif"
                  srcset="/faith-400.avif 400w, /faith-640.avif 640w, /faith-900.avif 900w"
                  sizes="(min-width: 1024px) 22rem, (min-width: 640px) 20rem, 16rem"
                />
                <source
                  type="image/webp"
                  srcset="/faith-400.webp 400w, /faith-640.webp 640w, /faith-900.webp 900w"
                  sizes="(min-width: 1024px) 22rem, (min-width: 640px) 20rem, 16rem"
                />
                <img
                  src="/faith-640.jpg"
                  alt="A selection of Faith's crocheted pieces arranged together"
                  width="2048"
                  height="2048"
                  loading="eager"
                  decoding="sync"
                  fetchpriority="high"
                  class="aspect-square h-full w-full object-cover transition-transform duration-[var(--duration-slow)] ease-soft group-hover:scale-[1.03]"
                />
              </picture>
            </div>

            <p class="pb-1 pt-4 text-center font-brand text-step-3 text-rose-text">by Faith</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
