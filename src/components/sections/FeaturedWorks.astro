---
/**
 * FeaturedWorks
 *
 * The previous version rendered the same six items twice — once in a mobile
 * carousel and once in a desktop grid — hiding one branch with `md:hidden`.
 * Both branches were in the DOM, so every visitor downloaded twelve images to
 * see six, and the lightbox bound duplicate handlers. This renders once and
 * lets CSS change the layout: a snap-scroll row on small screens, a grid from
 * the medium breakpoint up.
 *
 * Cards are calm here. Tape and tilt live only in the hero.
 */
import type { GalleryItem } from '@typedefs/index';
import Card from '@components/ui/Card.astro';
import GalleryImage from '@components/ui/GalleryImage.astro';

interface Props {
  items: GalleryItem[];
  limit?: number;
}

const { items, limit = 6 } = Astro.props;
const featured = items.slice(0, limit);
---

{
  featured.length > 0 && (
    <section class="py-20 sm:py-24" aria-labelledby="featured-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div data-reveal="up">
            <p class="label">Fresh off the hook</p>
            <h2
              id="featured-heading"
              class="mt-2 font-heading text-step-4 font-bold text-ink-display"
            >
              Latest creations
            </h2>
          </div>
          <a
            href="/gallery/"
            class="no-underline-reset group inline-flex items-center gap-2 font-heading text-step-0 font-semibold text-rose-text transition-colors hover:text-rose-hover"
            data-reveal="fade"
          >
            See all {items.length} pieces
            <svg
              class="h-4 w-4 transition-transform duration-[var(--duration-base)] ease-soft group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <ul
          class="scrollbar-hide -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 md:mx-0 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:px-0 md:pb-0 lg:grid-cols-3"
          role="list"
        >
          {featured.map((item, i) => (
            <li
              class="w-[16rem] flex-shrink-0 snap-center md:w-auto"
              data-reveal="up"
              data-reveal-delay={String((i % 3) * 90)}
            >
              <Card href={item.href} class="h-full">
                <GalleryImage
                  item={item}
                  wrapperClass="rounded-inner"
                  sizes="(min-width: 1024px) 22rem, (min-width: 768px) 45vw, 16rem"
                  maxWidth={800}
                  aspect="square"
                />
                <div class="px-2 pb-1 pt-4">
                  <p class="line-clamp-2 font-heading text-step-0 font-semibold text-ink-display">
                    {item.title}
                  </p>
                  <p class="label mt-1.5">{item.categoryLabel}</p>
                </div>
              </Card>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
