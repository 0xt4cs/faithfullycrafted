---
/**
 * ContactCard
 *
 * Both panels used to be a three-layer stack: an offset rotated backdrop, a
 * counter-rotated white card, and a washi-tape strip on top. That is now a
 * single `Card` each. The icons carry meaning next to their headings, so
 * they take `rose-text`; only the circles behind them use decorative tokens,
 * and those stay in `bg-*`.
 */
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import SocialIcon from '@components/ui/SocialIcon.astro';
import { SITE, SOCIALS } from '@lib/constants';
---

<section class="bg-page py-16 sm:py-20" aria-label="Contact information">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center" data-reveal="up">
      <h2 class="font-heading text-step-4 font-bold text-ink-display">Let's Connect</h2>
      <p class="mx-auto mt-3 max-w-md text-ink-muted">
        Have a question, want to order, or just want to say hi? I'd love to hear from you!
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <!-- Messenger -->
      <div data-reveal="left">
        <Card layout="text" class="h-full text-center">
          <div
            class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-control bg-rose-wash"
          >
            <svg
              class="h-8 w-8 text-rose-text"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 0C5.373 0 0 4.974 0 11.111c0 3.498 1.744 6.614 4.469 8.654V24l4.088-2.242c1.092.3 2.246.464 3.443.464 6.627 0 12-4.975 12-11.111S18.627 0 12 0zm1.191 14.963l-3.055-3.26-5.963 3.26L10.732 8.2l3.131 3.259L19.752 8.2l-6.561 6.763z"
              ></path>
            </svg>
          </div>
          <h3 class="font-heading text-step-1 font-bold text-ink-display">Message Me</h3>
          <p class="mt-2 text-step--1 text-ink-muted">
            The fastest way to reach me! Send a message on Facebook Messenger for orders and
            inquiries.
          </p>
          <Button
            href={SOCIALS.facebook.messenger}
            variant="primary"
            size="md"
            external
            class="mt-6"
          >
            Open Messenger
          </Button>
        </Card>
      </div>

      <!-- Email and socials -->
      <div data-reveal="right">
        <Card layout="text" class="h-full text-center">
          <div
            class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-control bg-decor-lavender/12"
          >
            <svg
              class="h-8 w-8 text-rose-text"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M16.8 7.3h.01"></path>
            </svg>
          </div>
          <h3 class="font-heading text-step-1 font-bold text-ink-display">Find Faith elsewhere</h3>
          <p class="mt-2 text-step--1 text-ink-muted">
            New pieces go up on Facebook and Instagram first, and her DMs are open on both.
          </p>

          <div class="mt-6 flex items-center justify-center gap-3">
            <SocialIcon platform="facebook" href={SOCIALS.facebook.url} />
            <SocialIcon platform="instagram" href={SOCIALS.instagram.url} />
            <SocialIcon platform="messenger" href={SOCIALS.facebook.messenger} />
          </div>

          <address class="mt-6 border-t border-rose-tint/60 pt-4 not-italic">
            <p
              class="flex items-center justify-center gap-1.5 font-body text-step--1 text-ink-muted"
            >
              <svg
                class="h-4 w-4 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              {SITE.location}
            </p>
          </address>
        </Card>
      </div>
    </div>
  </div>
</section>
