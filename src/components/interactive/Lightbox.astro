---
/**
 * Lightbox
 *
 * Rewritten, and its role narrowed. Gallery cards now navigate to a real
 * `/piece/<slug>/` page, which is shareable, indexable, and gives each piece
 * room for its story — so the lightbox is no longer the primary way to see a
 * photo larger. It is an "expand in place" affordance for readers browsing the
 * grid quickly, opened by the button on each card.
 *
 * Two deliberate changes from the previous implementation:
 *
 *  - The slideshow no longer starts on its own. Auto-advancing content that
 *    the reader did not ask for fails WCAG 2.2.2 unless it can be paused, and
 *    it also fought `prefers-reduced-motion`. Play is now opt-in, and the
 *    control reports its state.
 *  - Focus is trapped while open and returned to the button that opened it.
 *    Previously focus stayed behind the overlay, so a keyboard user tabbed
 *    through the page underneath.
 */
---

<div
  id="lightbox"
  class="fixed inset-0 z-[95] hidden items-center justify-center bg-ink-display/85 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Expanded photo"
  hidden
>
  <button
    id="lightbox-close"
    type="button"
    class="absolute right-3 top-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-card/90 text-ink-body shadow-2 transition-[background-color,transform] duration-[var(--duration-fast)] hover:bg-card hover:scale-105"
    aria-label="Close"
  >
    <svg
      viewBox="0 0 24 24"
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>

  <button
    id="lightbox-prev"
    type="button"
    class="absolute left-2 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-card/85 text-ink-body shadow-2 transition-[background-color,transform] duration-[var(--duration-fast)] hover:bg-card sm:left-4"
    aria-label="Previous photo"
  >
    <svg
      viewBox="0 0 24 24"
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 6l-6 6 6 6"></path>
    </svg>
  </button>

  <button
    id="lightbox-next"
    type="button"
    class="absolute right-2 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-card/85 text-ink-body shadow-2 transition-[background-color,transform] duration-[var(--duration-fast)] hover:bg-card sm:right-4"
    aria-label="Next photo"
  >
    <svg
      viewBox="0 0 24 24"
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 6l6 6-6 6"></path>
    </svg>
  </button>

  <figure class="mx-auto flex max-h-[92dvh] w-full max-w-4xl flex-col items-center px-4">
    <img
      id="lightbox-image"
      src=""
      alt=""
      width="1200"
      height="1200"
      class="max-h-[74dvh] w-auto max-w-full rounded-card bg-surface object-contain shadow-3"
    />
    <figcaption class="mt-4 max-w-2xl text-center">
      <p id="lightbox-caption" class="font-heading text-step-0 font-semibold text-white"></p>
      <div class="mt-3 flex items-center justify-center gap-3">
        <button
          id="lightbox-play"
          type="button"
          class="inline-flex min-h-[40px] items-center gap-2 rounded-control bg-card/90 px-3.5 py-2 font-heading text-step--1 font-semibold text-ink-body transition-colors duration-[var(--duration-fast)] hover:bg-card"
          aria-pressed="false"
        >
          <svg
            viewBox="0 0 16 16"
            class="h-3.5 w-3.5"
            fill="currentColor"
            aria-hidden="true"
            id="lightbox-play-icon"
          >
            <path d="M4 2.5l9 5.5-9 5.5z"></path>
          </svg>
          <span id="lightbox-play-label">Play slideshow</span>
        </button>
        <a
          id="lightbox-link"
          href="/"
          class="no-underline-reset rounded-control bg-card/90 px-3.5 py-2 font-heading text-step--1 font-semibold"
        >
          Open this piece
        </a>
        <p class="label text-white/70">
          <span class="tabular" id="lightbox-position">1</span>
          {' / '}
          <span class="tabular" id="lightbox-count">1</span>
        </p>
      </div>
    </figcaption>
  </figure>
</div>

<script>
  interface LightboxSlide {
    src: string;
    alt: string;
    caption: string;
    href: string;
  }

  function initLightbox() {
    const root = document.getElementById('lightbox');
    const image = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const captionEl = document.getElementById('lightbox-caption');
    const linkEl = document.getElementById('lightbox-link') as HTMLAnchorElement | null;
    const positionEl = document.getElementById('lightbox-position');
    const countEl = document.getElementById('lightbox-count');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const playBtn = document.getElementById('lightbox-play');
    const playLabel = document.getElementById('lightbox-play-label');
    const playIcon = document.getElementById('lightbox-play-icon');

    if (!root || !image) return;

    let slides: LightboxSlide[] = [];
    let index = 0;
    let timer: number | undefined;
    let opener: HTMLElement | null = null;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function collect() {
      slides = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]'))
        .filter((el) => !el.closest('[hidden]'))
        .map((el) => ({
          src: el.dataset.lightboxSrc || '',
          alt: el.dataset.lightboxAlt || '',
          caption: el.dataset.lightboxCaption || '',
          href: el.dataset.lightboxHref || '/',
        }));
    }

    function render() {
      const slide = slides[index];
      if (!slide) return;
      image!.src = slide.src;
      image!.alt = slide.alt;
      if (captionEl) captionEl.textContent = slide.caption;
      if (linkEl) linkEl.href = slide.href;
      if (positionEl) positionEl.textContent = String(index + 1);
      if (countEl) countEl.textContent = String(slides.length);

      const single = slides.length < 2;
      prevBtn?.toggleAttribute('hidden', single);
      nextBtn?.toggleAttribute('hidden', single);
      playBtn?.toggleAttribute('hidden', single);
    }

    function stop() {
      if (timer) window.clearInterval(timer);
      timer = undefined;
      playBtn?.setAttribute('aria-pressed', 'false');
      if (playLabel) playLabel.textContent = 'Play slideshow';
      if (playIcon) playIcon.innerHTML = '<path d="M4 2.5l9 5.5-9 5.5z" />';
    }

    function play() {
      // Never auto-start, and never run at all under reduced-motion.
      if (prefersReducedMotion || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => go(1), 3800);
      playBtn?.setAttribute('aria-pressed', 'true');
      if (playLabel) playLabel.textContent = 'Pause slideshow';
      if (playIcon) playIcon.innerHTML = '<path d="M4 3h3v10H4zM9 3h3v10H9z" />';
    }

    function go(step: number) {
      if (slides.length === 0) return;
      index = (index + step + slides.length) % slides.length;
      render();
    }

    function open(startIndex: number, trigger: HTMLElement) {
      collect();
      if (slides.length === 0) return;
      opener = trigger;
      index = Math.max(0, Math.min(startIndex, slides.length - 1));
      render();
      root!.removeAttribute('hidden');
      root!.classList.remove('hidden');
      root!.classList.add('flex');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function close() {
      stop();
      root!.setAttribute('hidden', '');
      root!.classList.add('hidden');
      root!.classList.remove('flex');
      document.body.style.overflow = '';
      opener?.focus();
      opener = null;
    }

    function isOpen() {
      return !root!.hasAttribute('hidden');
    }

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement)?.closest<HTMLElement>(
        '[data-lightbox-trigger]',
      );
      if (!trigger) return;
      event.preventDefault();
      collect();
      const all = Array.from(
        document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]'),
      ).filter((el) => !el.closest('[hidden]'));
      open(all.indexOf(trigger), trigger);
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => {
      stop();
      go(-1);
    });
    nextBtn?.addEventListener('click', () => {
      stop();
      go(1);
    });
    playBtn?.addEventListener('click', () => {
      if (timer) stop();
      else play();
    });

    // Click the backdrop, not the figure, to dismiss.
    root.addEventListener('click', (event) => {
      if (event.target === root) close();
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        close();
        return;
      }
      if (event.key === 'ArrowLeft') {
        stop();
        go(-1);
        return;
      }
      if (event.key === 'ArrowRight') {
        stop();
        go(1);
        return;
      }
      if (event.key === 'Tab') {
        const focusables = Array.from(
          root!.querySelectorAll<HTMLElement>('button:not([hidden]), a[href]'),
        );
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    // Touch swipe.
    let touchStartX = 0;
    root.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.changedTouches[0].screenX;
      },
      { passive: true },
    );
    root.addEventListener(
      'touchend',
      (event) => {
        const delta = event.changedTouches[0].screenX - touchStartX;
        if (Math.abs(delta) < 48) return;
        stop();
        go(delta > 0 ? -1 : 1);
      },
      { passive: true },
    );
  }

  initLightbox();
  document.addEventListener('astro:after-swap', initLightbox);
</script>
